{
  "name": "copilot-usage-monitor",
  "displayName": "Copilot Usage Monitor (Local)",
  "description": "Shows your own Copilot usage, in tokens or estimated USD, as observed in local Copilot session logs on this computer. Month history, trend, per-project and per-tool views and a personal target range. No network, nothing stored. Not affiliated with GitHub or Microsoft.",
  "keywords": [
    "copilot",
    "usage",
    "tokens",
    "local",
    "privacy",
    "status bar"
  ],
  "publisher": "local",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "pretest:integration": "npm run build && tsc -p tsconfig.test.json",
    "test:integration": "vscode-test",
    "test:perf": "PERF=1 vitest run test/core/perf.test.ts",
    "package": "vsce package --no-dependencies",
    "probe": "node tools/schema-probe.mjs",
    "probe:chat": "node tools/chat-schema-probe.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Halmurat-Uyghur/copilot-usage-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/Halmurat-Uyghur/copilot-usage-monitor/issues"
  },
  "homepage": "https://github.com/Halmurat-Uyghur/copilot-usage-monitor#readme",
  "contributes": {
    "commands": [
      {
        "command": "copilotUsageMonitor.showDetails",
        "title": "Copilot Usage: Show Local Details"
      },
      {
        "command": "copilotUsageMonitor.pinSession",
        "title": "Copilot Usage: Pin Session…"
      },
      {
        "command": "copilotUsageMonitor.refresh",
        "title": "Copilot Usage: Refresh"
      },
      {
        "command": "copilotUsageMonitor.selectMonth",
        "title": "Copilot Usage: Show Month…"
      },
      {
        "command": "copilotUsageMonitor.toggleUnit",
        "title": "Copilot Usage: Switch Tokens / USD (est.)"
      },
      {
        "command": "copilotUsageMonitor.setUnit",
        "title": "Copilot Usage: Set Unit"
      },
      {
        "command": "copilotUsageMonitor.filter",
        "title": "Copilot Usage: Filter by Project or Tool…"
      },
      {
        "command": "copilotUsageMonitor.setFilter",
        "title": "Copilot Usage: Set Filter"
      }
    ],
    "configuration": {
      "title": "Copilot Usage Monitor",
      "properties": {
        "copilotUsageMonitor.copilotHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Folder that contains Copilot's session-state. Empty: use COPILOT_HOME, else ~/.copilot."
        },
        "copilotUsageMonitor.historyMonths": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 24,
          "description": "How many months of Copilot session logs to read for the month picker and trend chart, this month included. Older logs are read once at start-up; nothing is stored."
        },
        "copilotUsageMonitor.display": {
          "type": "string",
          "enum": [
            "tokens",
            "cost"
          ],
          "default": "tokens",
          "enumDescriptions": [
            "Input + output tokens.",
            "Estimated USD: Copilot's logged AI credits × $0.01."
          ],
          "description": "Unit for the status bar and panel figures."
        },
        "copilotUsageMonitor.monthlyTargetMin": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "description": "Optional personal target: the least estimated USD you want to use per month. Below it, the status bar shows a down arrow."
        },
        "copilotUsageMonitor.monthlyTargetMax": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "description": "Optional personal target: the most estimated USD you want to use per month. Above it, the status bar turns amber with a flame icon."
        },
        "copilotUsageMonitor.projectNames": {
          "type": "boolean",
          "default": true,
          "description": "Read each session's start line to label it with a project: the GitHub repository name, else the folder name. Full paths are never kept. Turn off to stop reading that line."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "copilotUsageMonitor.setUnit",
          "when": "false"
        },
        {
          "command": "copilotUsageMonitor.setFilter",
          "when": "false"
        }
      ]
    }
  }
}
