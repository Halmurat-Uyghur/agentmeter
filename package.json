{
  "name": "copilot-usage-monitor",
  "displayName": "Copilot Usage Monitor (Local)",
  "description": "Shows your own Copilot usage, in tokens or estimated USD, as observed in local Copilot session logs on this computer. Side bar summary, a sectioned details panel, month history, trend, per-project and per-tool views, session totals from older Copilot and a personal target range. No credentials read, nothing stored, and no network unless you pick a display currency other than USD (for example CAD, at the daily exchange rate). Not affiliated with GitHub or Microsoft.",
  "keywords": [
    "copilot",
    "usage",
    "tokens",
    "local",
    "privacy",
    "status bar"
  ],
  "publisher": "local",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "pretest:integration": "npm run build && tsc -p tsconfig.test.json",
    "test:integration": "vscode-test",
    "test:perf": "PERF=1 vitest run test/core/perf.test.ts",
    "package": "vsce package --no-dependencies",
    "probe": "node tools/schema-probe.mjs",
    "probe:chat": "node tools/chat-schema-probe.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Halmurat-Uyghur/copilot-usage-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/Halmurat-Uyghur/copilot-usage-monitor/issues"
  },
  "homepage": "https://github.com/Halmurat-Uyghur/copilot-usage-monitor#readme",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotUsageMonitor",
          "title": "Copilot Usage (Local)",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "copilotUsageMonitor": [
        {
          "type": "webview",
          "id": "copilotUsageMonitor.summary",
          "name": "Summary",
          "contextualTitle": "Copilot Usage (Local)",
          "icon": "$(graph)",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "copilotUsageMonitor.showDetails",
        "title": "Show Local Details",
        "shortTitle": "Open panel",
        "category": "Copilot Usage",
        "icon": "$(dashboard)"
      },
      {
        "command": "copilotUsageMonitor.pinSession",
        "title": "Pin Session…",
        "category": "Copilot Usage",
        "icon": "$(pinned)"
      },
      {
        "command": "copilotUsageMonitor.refresh",
        "title": "Refresh",
        "category": "Copilot Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "copilotUsageMonitor.selectMonth",
        "title": "Show Month…",
        "category": "Copilot Usage",
        "icon": "$(calendar)"
      },
      {
        "command": "copilotUsageMonitor.toggleUnit",
        "title": "Switch Tokens / USD (est.)",
        "shortTitle": "Switch unit",
        "category": "Copilot Usage",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "copilotUsageMonitor.setUnit",
        "title": "Set Unit",
        "category": "Copilot Usage"
      },
      {
        "command": "copilotUsageMonitor.filter",
        "title": "Filter by Project or Tool…",
        "category": "Copilot Usage",
        "icon": "$(filter)"
      },
      {
        "command": "copilotUsageMonitor.setFilter",
        "title": "Set Filter",
        "category": "Copilot Usage"
      },
      {
        "command": "copilotUsageMonitor.showSection",
        "title": "Show Section…",
        "category": "Copilot Usage",
        "icon": "$(list-flat)"
      },
      {
        "command": "copilotUsageMonitor.showSession",
        "title": "Show Session Calls",
        "category": "Copilot Usage"
      },
      {
        "command": "copilotUsageMonitor.selectCurrency",
        "title": "Choose Currency…",
        "category": "Copilot Usage"
      }
    ],
    "configuration": {
      "title": "Copilot Usage Monitor",
      "properties": {
        "copilotUsageMonitor.copilotHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Folder that contains Copilot's session-state. Empty: use COPILOT_HOME, else ~/.copilot."
        },
        "copilotUsageMonitor.historyMonths": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 24,
          "description": "How many months of Copilot session logs to read for the month picker and trend chart, this month included. Older logs are read once at start-up; nothing is stored."
        },
        "copilotUsageMonitor.display": {
          "type": "string",
          "enum": [
            "tokens",
            "cost"
          ],
          "default": "tokens",
          "enumDescriptions": [
            "Input + output tokens.",
            "Estimated USD: Copilot's logged AI credits × $0.01."
          ],
          "description": "Unit for the status bar and panel figures."
        },
        "copilotUsageMonitor.currency": {
          "type": "string",
          "default": "USD",
          "enum": [
            "USD",
            "CAD",
            "EUR",
            "GBP",
            "AUD",
            "NZD",
            "JPY",
            "CHF",
            "INR",
            "CNY",
            "SGD",
            "HKD",
            "SEK",
            "NOK",
            "DKK",
            "MXN",
            "BRL",
            "KRW"
          ],
          "description": "Currency for estimated cost. USD needs no network. Any other currency is converted at the daily European Central Bank USD reference rate, fetched from api.frankfurter.dev at start-up and every 6 hours (the request carries only the currency code). Monthly targets are then entered in this currency."
        },
        "copilotUsageMonitor.monthlyTargetMin": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "description": "Optional personal target: the least estimated cost (in the chosen currency) you want to use per month. Below it, the status bar shows a down arrow."
        },
        "copilotUsageMonitor.monthlyTargetMax": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "description": "Optional personal target: the most estimated cost (in the chosen currency) you want to use per month. Above it, the status bar turns amber with a flame icon."
        },
        "copilotUsageMonitor.projectNames": {
          "type": "boolean",
          "default": true,
          "description": "Read each session's start line to label it with a project: the GitHub repository name, else the folder name. A folder named by an ID shows the session title (the name: line of workspace.yaml) instead. Full paths are never kept. Turn off to stop reading both."
        },
        "copilotUsageMonitor.sessionTotals": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Count sessions from Copilot before 1.0.99, which have no per-call records, from the per-model total Copilot writes when a session ends. Only the token counts, call count and logged AI credits are kept; file paths and other fields on that line are dropped while reading. Turn off to skip those lines without reading them."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "copilotUsageMonitor.setUnit",
          "when": "false"
        },
        {
          "command": "copilotUsageMonitor.setFilter",
          "when": "false"
        },
        {
          "command": "copilotUsageMonitor.showSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "copilotUsageMonitor.showDetails",
          "when": "view == copilotUsageMonitor.summary",
          "group": "navigation@1"
        },
        {
          "command": "copilotUsageMonitor.toggleUnit",
          "when": "view == copilotUsageMonitor.summary",
          "group": "navigation@2"
        },
        {
          "command": "copilotUsageMonitor.refresh",
          "when": "view == copilotUsageMonitor.summary",
          "group": "navigation@3"
        },
        {
          "command": "copilotUsageMonitor.filter",
          "when": "view == copilotUsageMonitor.summary",
          "group": "1_view@1"
        },
        {
          "command": "copilotUsageMonitor.selectMonth",
          "when": "view == copilotUsageMonitor.summary",
          "group": "1_view@2"
        },
        {
          "command": "copilotUsageMonitor.showSection",
          "when": "view == copilotUsageMonitor.summary",
          "group": "1_view@3"
        },
        {
          "command": "copilotUsageMonitor.pinSession",
          "when": "view == copilotUsageMonitor.summary",
          "group": "1_view@4"
        }
      ]
    }
  }
}
